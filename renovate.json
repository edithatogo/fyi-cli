{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticPrefixFixDepsChoreOthers",
    ":automergeMinor",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":enableVulnerabilityAlerts",
    ":dependencyDashboard",
    ":maintainLockFilesWeekly"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "ruff",
        "basedpyright"
      ],
      "groupName": "linters",
      "groupSlug": "linters"
    },
    {
      "matchPackageNames": [
        "pytest",
        "pytest-*"
      ],
      "groupName": "pytest",
      "groupSlug": "pytest"
    },
    {
      "matchPackageNames": [
        "typer",
        "rich",
        "httpx",
        "pydantic",
        "fastmcp"
      ],
      "groupName": "core-dependencies",
      "groupSlug": "core-dependencies"
    },
    {
      "matchPackageNames": [
        "cryptography",
        "keyring"
      ],
      "groupName": "security-dependencies",
      "groupSlug": "security-dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "breaking-change"
      ],
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "schedule": [
    "before 6am on Monday"
  ],
  "timezone": "Pacific/Auckland",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "rangeStrategy": "widen",
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": true,
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "pip_requirements": {
    "managerFilePatterns": [
      "requirements\\.txt$",
      "requirements-.*\\.txt$"
    ]
  },
  "pip_setup": {
    "managerFilePatterns": [
      "setup\\.py$"
    ]
  },
  "minimumReleaseAge": "3 days"
}
