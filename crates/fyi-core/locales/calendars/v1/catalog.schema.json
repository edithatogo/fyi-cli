{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fyi-cli:holiday-calendar-catalog:v1",
  "title": "Holiday Calendar Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calendars"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "calendars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jurisdiction",
          "revision",
          "valid_from",
          "valid_to",
          "weekend_days",
          "excluded_dates"
        ],
        "properties": {
          "jurisdiction": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,8})?$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": "string",
            "format": "date"
          },
          "weekend_days": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "excluded_dates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    }
  }
}
