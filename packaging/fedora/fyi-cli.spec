# BLOCKED COPR/RPM template, not a Fedora-approved package.
# Verify source/vendor hashes, review bundled dependency licences and validate
# the native SRPM build before any upload. Fedora archive policy review remains
# separate from a private COPR build. No credential or submission is provided.
# Historical release v1.2.0 declares Rust package version 0.1.2.
%global source_commit 86fcbd8914037735b6f27e5a329d5f3013033efd
%global source_sha256 @SOURCE_SHA256@
%global vendor_sha256 @CARGO_VENDOR_SHA256@

Name:           fyi-cli
Version:        0.1.2
Release:        1%{?dist}
Summary:        Privacy-focused multi-jurisdiction FOI/OIA CLI for Alaveteli
License:        MIT
URL:            https://github.com/edithatogo/fyi-cli
Source0:        https://github.com/edithatogo/fyi-cli/archive/%{source_commit}.tar.gz
# Local archive containing vendor/ and cargo-config.toml, generated by
# cargo vendor --locked against this exact source's Cargo.lock.
Source1:        fyi-cli-%{version}-vendor.tar.gz
ExclusiveArch:  x86_64 aarch64

BuildRequires:  cargo
BuildRequires:  rust
BuildRequires:  openssl-devel
BuildRequires:  pkgconfig
BuildRequires:  gcc
BuildRequires:  make

Requires:       openssl-libs
Requires:       ca-certificates
Recommends:     tor

%description
fyi-cli tracks and manages Freedom of Information / Official Information
requests against Alaveteli-based platforms, with optional Tor routing
and local SQLite storage.

%package -n fyi-mcp
Summary:        MCP server for FYI/Alaveteli request management
Requires:       openssl-libs
Requires:       ca-certificates
Recommends:     %{name} = %{version}-%{release}

%description -n fyi-mcp
fyi-mcp is the Model Context Protocol server companion to fyi-cli.

%prep
printf '%s  %s\n' '%{source_sha256}' '%{SOURCE0}' | sha256sum --check -
printf '%s  %s\n' '%{vendor_sha256}' '%{SOURCE1}' | sha256sum --check -
%autosetup -n fyi-cli-%{source_commit}
tar -xf %{SOURCE1}
test -d vendor
test -f cargo-config.toml
install -Dm644 cargo-config.toml .cargo/vendor-config.toml

%build
export CARGO_TARGET_DIR=%{_builddir}/cargo-target
export CARGO_HOME="$PWD/.cargo-home"
export CARGO_NET_OFFLINE=true
cargo --config .cargo/vendor-config.toml build --frozen --release --package fyi-cli --package fyi-mcp

%install
install -D -m 0755 %{_builddir}/cargo-target/release/fyi-cli %{buildroot}%{_bindir}/fyi-cli
install -D -m 0755 %{_builddir}/cargo-target/release/fyi-mcp %{buildroot}%{_bindir}/fyi-mcp

%check
export CARGO_TARGET_DIR=%{_builddir}/cargo-target
export CARGO_HOME="$PWD/.cargo-home"
export CARGO_NET_OFFLINE=true
cargo --config .cargo/vendor-config.toml test --frozen --release --package fyi-cli --package fyi-mcp

%files
%license LICENSE
%doc README.md
%{_bindir}/fyi-cli

%files -n fyi-mcp
%license LICENSE
%{_bindir}/fyi-mcp

