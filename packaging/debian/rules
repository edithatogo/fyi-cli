#!/usr/bin/make -f
# BLOCKED Debian/PPA template for fyi-cli / fyi-mcp (Rust workspace).
# Expected layout when building a source package: this debian/ directory
# at the root of an exported source tree (or linked from packaging/debian).
#
# Homepage: https://github.com/edithatogo/fyi-cli
# Version: 0.1.2
# License: MIT

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/cargo_home
export CARGO_TARGET_DIR = $(CURDIR)/target

# Provide vendor/ and .cargo/vendor-config.toml generated from the exact source
# lockfile before dpkg-buildpackage. Source and vendor archives need recorded
# hashes, provenance and dependency licence review. See README.md alongside.
# dpkg-buildpackage supplies SOURCE_DATE_EPOCH from the dated changelog.
export CARGO_NET_OFFLINE = true
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	test -d vendor
	test -f .cargo/vendor-config.toml

override_dh_auto_build:
	cargo --config .cargo/vendor-config.toml build --frozen --release --package fyi-cli --package fyi-mcp

override_dh_auto_test:
	cargo --config .cargo/vendor-config.toml test --frozen --release --package fyi-cli --package fyi-mcp

override_dh_auto_install:
	install -Dm755 target/release/fyi-cli debian/fyi-cli/usr/bin/fyi-cli
	install -Dm755 target/release/fyi-mcp debian/fyi-mcp/usr/bin/fyi-mcp
	install -Dm644 debian/copyright debian/fyi-cli/usr/share/doc/fyi-cli/copyright
	install -Dm644 debian/copyright debian/fyi-mcp/usr/share/doc/fyi-mcp/copyright
	install -Dm644 README.md debian/fyi-cli/usr/share/doc/fyi-cli/README.md

override_dh_auto_clean:
	rm -rf target $(CARGO_HOME)
	dh_auto_clean
