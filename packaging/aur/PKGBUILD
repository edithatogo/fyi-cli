# Maintainer: edithatogo <15080672+edithatogo@users.noreply.github.com>
# BLOCKED TEMPLATE: unresolved hashes are deliberately invalid; never use SKIP.
# Historical GitHub release v1.2.0 contains Rust package metadata 0.1.2.
# Reconcile that release/version mapping before submission; this is not master.
# The separately hashed vendor archive must contain vendor/ and cargo-config.toml
# generated from this exact source's Cargo.lock with cargo vendor --locked.
# Generate that archive outside the build sandbox; review all bundled licences.

pkgname=fyi-cli
pkgver=0.1.2
pkgrel=1
_commit=86fcbd8914037735b6f27e5a329d5f3013033efd
pkgdesc="Privacy-focused multi-jurisdiction FOI/OIA CLI and MCP server for Alaveteli"
arch=('x86_64' 'aarch64')
url="https://github.com/edithatogo/fyi-cli"
license=('MIT')
depends=('gcc-libs' 'openssl')
makedepends=('cargo' 'pkgconf')
optdepends=('tor: optional Tor routing for privacy-sensitive requests')
provides=('fyi-mcp')
options=('!lto')
source=(
  "${pkgname}-${_commit}.tar.gz::https://github.com/edithatogo/fyi-cli/archive/${_commit}.tar.gz"
  "fyi-cli-${pkgver}-vendor.tar.gz"
)
sha256sums=('@SOURCE_SHA256@' '@CARGO_VENDOR_SHA256@')

prepare() {
  cd "${srcdir}/fyi-cli-${_commit}"
  test -d "${srcdir}/vendor"
  test -f "${srcdir}/cargo-config.toml"
  cp -a "${srcdir}/vendor" vendor
  install -Dm644 "${srcdir}/cargo-config.toml" .cargo/vendor-config.toml
}

build() {
  cd "${srcdir}/fyi-cli-${_commit}"
  export CARGO_TARGET_DIR=target
  cargo --config .cargo/vendor-config.toml build --frozen --release --package fyi-cli --package fyi-mcp
}

check() {
  cd "${srcdir}/fyi-cli-${_commit}"
  cargo --config .cargo/vendor-config.toml test --frozen --release --package fyi-cli --package fyi-mcp
}

package() {
  cd "${srcdir}/fyi-cli-${_commit}"
  install -Dm755 target/release/fyi-cli "${pkgdir}/usr/bin/fyi-cli"
  install -Dm755 target/release/fyi-mcp "${pkgdir}/usr/bin/fyi-mcp"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
