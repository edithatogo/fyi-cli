#!/usr/bin/env bash
# Install only an explicitly reviewed, version-bound CLI release.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec python3 -I - "${script_dir}/../checksums" "${1:-}" "$(uname -s)" "$(uname -m)" <<'PY'
import gzip
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("asdf-fyi-cli: Python 3.11 or newer is required")

VERSION = re.compile(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)")
PLATFORMS = {
    ("Linux", "x86_64"): "fyi-cli-linux-amd64.tar.gz",
    ("Darwin", "x86_64"): "fyi-cli-macos-amd64.tar.gz",
    ("Darwin", "arm64"): "fyi-cli-macos-arm64.tar.gz",
}
MAX_ARCHIVE_BYTES = 128 * 1024 * 1024
MAX_BINARY_BYTES = 256 * 1024 * 1024


class LimitedTarStream:
    """Bound inflated tar headers as well as the executable member."""

    def __init__(self, stream):
        self.stream = stream
        self.remaining = MAX_BINARY_BYTES + 512 * 1024

    def read(self, size):
        if size < 0 or size > self.remaining:
            raise ValueError("decompressed archive exceeds the size limit")
        data = self.stream.read(size)
        self.remaining -= len(data)
        return data


def load_checksums(directory, version):
    if len(version) > 32 or not VERSION.fullmatch(version):
        raise ValueError("only stable, canonical X.Y.Z versions are supported")
    path = directory / (version + ".sha256")
    if directory.is_symlink() or path.is_symlink() or not path.is_file():
        raise ValueError("release has no committed checksum approval")
    if path.stat().st_size > 4096:
        raise ValueError("checksum approval is oversized")
    lines = path.read_text(encoding="utf-8").splitlines()
    if lines[:2] != ["# release-tag: v" + version, "# binary-version: " + version]:
        raise ValueError("release tag and binary version must match the requested version")
    checksums = {}
    for line in lines[2:]:
        if not line:
            continue
        match = re.fullmatch(r"([0-9a-f]{64})  ([a-z0-9.-]+)", line)
        if match is None:
            raise ValueError("invalid checksum approval entry")
        digest, name = match.groups()
        if name not in PLATFORMS.values() or name in checksums or len(set(digest)) == 1:
            raise ValueError("unsupported, duplicated or placeholder checksum approval")
        checksums[name] = digest
    if not checksums:
        raise ValueError("checksum approval contains no supported CLI assets")
    return checksums


def list_versions(directory):
    if directory.is_symlink():
        raise ValueError("checksum approval directory must not be a symlink")
    versions = []
    for path in directory.glob("*.sha256"):
        load_checksums(directory, path.stem)
        versions.append(path.stem)
    print(" ".join(sorted(versions, key=lambda version: tuple(map(int, version.split("."))))))


def extract_cli(archive, candidate):
    # Never extract archive-controlled paths. Accept exactly one root regular file.
    count = 0
    with gzip.open(archive, "rb") as compressed, tarfile.open(
        fileobj=LimitedTarStream(compressed), mode="r|"
    ) as bundle:
        for member in bundle:
            count += 1
            if count != 1 or member.name != "fyi-cli" or not member.isfile():
                raise ValueError("archive must contain only the root regular file fyi-cli")
            if member.size <= 0 or member.size > MAX_BINARY_BYTES:
                raise ValueError("CLI archive member has an invalid size")
            source = bundle.extractfile(member)
            if source is None:
                raise ValueError("CLI archive member is unreadable")
            with source, candidate.open("xb") as destination:
                shutil.copyfileobj(source, destination, length=1024 * 1024)
            if candidate.stat().st_size != member.size:
                raise ValueError("CLI archive member is truncated")
    if count != 1:
        raise ValueError("archive contains no CLI executable")
    candidate.chmod(0o755)


def check_binary_version(candidate, version, temporary):
    home = temporary / "smoke-home"
    home.mkdir()
    environment = {
        "PATH": os.defpath,
        "HOME": str(home),
        "XDG_CONFIG_HOME": str(home / "config"),
        "XDG_DATA_HOME": str(home / "data"),
        "XDG_CACHE_HOME": str(home / "cache"),
    }
    result = subprocess.run(
        [str(candidate), "--version"], check=True, capture_output=True,
        text=True, timeout=10, cwd=home, env=environment,
    )
    if result.stdout.strip() != "fyi-cli " + version:
        raise ValueError("CLI binary version does not match the approved release")


def install(directory, system, machine):
    if os.environ.get("ASDF_INSTALL_TYPE") != "version":
        raise ValueError("only version installations are supported; refs are not accepted")
    version = os.environ.get("ASDF_INSTALL_VERSION", "")
    checksums = load_checksums(directory, version)
    asset = PLATFORMS.get((system, machine))
    if asset is None or asset not in checksums:
        raise ValueError("no approved release asset for this operating system and architecture")
    prefix = Path(os.environ.get("ASDF_INSTALL_PATH", ""))
    if not prefix.is_absolute():
        raise ValueError("ASDF_INSTALL_PATH must be an absolute installation directory")
    binaries = prefix / "bin"
    destination = binaries / "fyi-cli"
    if prefix.is_symlink() or binaries.is_symlink() or destination.is_symlink():
        raise ValueError("installation paths must not be symlinks")
    curl = shutil.which("curl")
    if curl is None:
        raise ValueError("curl is required")
    url = "https://github.com/edithatogo/fyi-cli/releases/download/v" + version + "/" + asset
    with tempfile.TemporaryDirectory(prefix="asdf-fyi-cli-") as temporary_name:
        temporary = Path(temporary_name)
        archive = temporary / "release.tar.gz"
        subprocess.run(
            [curl, "--disable", "--fail", "--silent", "--show-error", "--location",
             "--proto", "=https", "--proto-redir", "=https",
             "--connect-timeout", "15", "--max-time", "60",
             "--max-filesize", str(MAX_ARCHIVE_BYTES), "--output", str(archive), url],
            check=True, timeout=65,
        )
        if not archive.is_file() or archive.stat().st_size > MAX_ARCHIVE_BYTES:
            raise ValueError("downloaded archive has an invalid size")
        with archive.open("rb") as source:
            digest = hashlib.file_digest(source, "sha256").hexdigest()
        if digest != checksums[asset]:
            raise ValueError("release checksum mismatch")
        candidate = temporary / "fyi-cli"
        extract_cli(archive, candidate)
        check_binary_version(candidate, version, temporary)
        binaries.mkdir(parents=True, exist_ok=True)
        # Rename on the destination filesystem only after every check succeeds.
        with tempfile.TemporaryDirectory(prefix=".fyi-cli-", dir=binaries) as staging:
            staged_binary = Path(staging) / "fyi-cli"
            shutil.copyfile(candidate, staged_binary)
            staged_binary.chmod(0o755)
            os.replace(staged_binary, destination)
    print("asdf-fyi-cli: installed " + version)


try:
    directory = Path(sys.argv[1])
    mode = sys.argv[2]
    if mode == "--list-all":
        list_versions(directory)
    elif mode:
        raise ValueError("unsupported installer argument")
    else:
        install(directory, sys.argv[3], sys.argv[4])
except (OSError, ValueError, tarfile.TarError, subprocess.SubprocessError) as error:
    print("asdf-fyi-cli: " + str(error), file=sys.stderr)
    sys.exit(1)
PY
